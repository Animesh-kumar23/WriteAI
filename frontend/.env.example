# Frontend environment variables
# Copy to .env and fill in real values:
#   cp .env.example .env

# URL of the backend API (no trailing slash)
VITE_API_BASE_URL=http://localhost:3000

# Set to "true" to enable footer contact links (email, GitHub, LinkedIn).
# Leave unset or "false" for the public-facing deploy where you want
# buttons to be visible but not functional.
VITE_SHOW_CONTACT_INFO=false
