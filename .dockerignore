# Applies to the root Dockerfile (production build).

# Never copy node_modules — they get installed inside the container
**/node_modules

# Never bake secrets into the image
**/.env
**/.env.*

# Frontend build output is produced inside the container (Stage 1)
frontend/dist

# Uploaded files belong on a volume, not in the image
backend/uploads

# Git history is not needed inside the image
.git
.gitignore

# Editor / OS noise
.DS_Store
Thumbs.db
