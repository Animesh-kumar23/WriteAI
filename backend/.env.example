# Backend .env — copy to .env and fill in real values.
#
#   cp .env.example .env

# Required
DB_URI=mongodb://127.0.0.1:27017/writeai
JWT_SECRET_KEY=replace_with_a_long_random_string
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Optional — defaults shown are what the app uses if unset
PORT=3000
CLIENT_URL=http://localhost:5173
REDIS_URL=redis://127.0.0.1:6379
AI_DAILY_LIMIT=100
ATLAS_SEARCH_ENABLED=false
RAG_ENABLED=false
EMBEDDING_MODEL=gemini-embedding-001
