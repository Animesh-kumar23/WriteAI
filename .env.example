# Root .env - used by Docker Compose for local testing.
# Copy this file to .env and fill in real values. Do not commit .env.
#
#   cp .env.example .env

JWT_SECRET_KEY=replace_with_a_long_random_string
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Optional. The app still runs without Redis; queues and distributed limits
# fall back or are disabled. Add a managed Redis URL on AWS when you need it.
REDIS_URL=
