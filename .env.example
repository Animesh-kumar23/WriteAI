# Root .env — used by docker-compose only.
# Copy this file to .env and fill in real values.
#
#   cp .env.example .env
#
# These two secrets are the only things docker-compose can't hard-code.
# Everything else (DB_URI, REDIS_URL, etc.) is set directly in docker-compose.yml.

JWT_SECRET_KEY=replace_with_a_long_random_string
GEMINI_API_KEY=replace_with_your_gemini_api_key
